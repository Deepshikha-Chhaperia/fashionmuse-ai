# Server-side only, never exposed to the browser
VERTEX_API_KEY=your_vertex_express_api_key_here
IMAGE_MODEL=gemini-3.1-flash-image
# Previous default: gemini-2.5-flash-image
VERTEX_LOCATION=global
# Previous default: us-central1 (gemini-3.1-flash-image requires global)
IMAGE_SIZE=2K
# Allowed: 1K or 2K (defaults to 2K; 4K exceeds the 15 MB response limit)
DEBUG_LOGS=false
