# AI API Keys - Priority Order: Gemini → OpenAI → OpenRouter

# 1. Gemini Nano Banana Pro (Primary - Recommended)
# Model: gemini-3-pro-image-preview
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
# Note: Requires billing-enabled Google Cloud project
# Cost: ~$0.02-0.04 per image
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenAI (Fallback 1 - Optional but recommended)
# Model: DALL-E 3
# Get your OpenAI API key from: https://platform.openai.com/api-keys
# Cost: ~$0.04-0.08 per image
VITE_OPENAI_API_KEY=your_openai_api_key_here

# 3. OpenRouter (Fallback 2 - Optional)
# Access to multiple models through one API
# Get your OpenRouter API key from: https://openrouter.ai/keys
# Cost: Varies by model
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
